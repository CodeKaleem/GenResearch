# ============================================================
# GenResearch — recommended chat speed/reliability settings
# Merge these into backend/.env (keep your own SUPABASE_*, TAVILY_*, SEMANTIC_SCHOLAR_* values).
# Settings marked [REINDEX] need:  python -m scripts.reindex_papers
# ============================================================

# ── Keep models loaded ───────────────────────────────────────
OLLAMA_KEEP_ALIVE=30m
OLLAMA_CHAT_READ_TIMEOUT=120

# ── GPU: -1 = let Ollama decide (uses the GPU when the host has one) ──
# 0 forces CPU. On a CPU-only host -1 behaves the same, so it is safe either way.
OLLAMA_HEAVY_NUM_GPU=-1
OLLAMA_MID_NUM_GPU=-1
OLLAMA_LIGHT_NUM_GPU=-1

# ── CPU threads (only matter when running on CPU) ────────────
# Set the chat tier (MID) to the host's PHYSICAL core count, not more.
# Two concurrent MID requests split those cores; use 1 if chat shares the box with pipeline runs.
OLLAMA_MID_NUM_THREAD=4
OLLAMA_MID_MAX_CONCURRENT=1

# ── One context size per model (different num_ctx makes Ollama reload the model) ──
# Judge nodes (final_qa, section_critic, citation_verify) request OLLAMA_JUDGE_CONTEXT,
# so every tier and the judge must agree.
OLLAMA_HEAVY_CONTEXT=8192
OLLAMA_MID_CONTEXT=8192
OLLAMA_LIGHT_CONTEXT=8192
OLLAMA_JUDGE_CONTEXT=8192

# ── Retrieval quality [REINDEX] ──────────────────────────────
# nomic-embed-text is trained with task prefixes; leaving them off hurts retrieval.
OLLAMA_EMBED_PREFIXES=true
# 512 characters (~120 tokens) is too small to hold a finding plus its context.
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# ── Chat behaviour ───────────────────────────────────────────
CHAT_TOP_K=8
CHAT_BROAD_TOP_K=12
CHAT_FETCH_MULTIPLIER=3
# Cosine distance cutoff. Passages farther than this are not sent to the model
# (it answers "not found" instead of improvising). Raise if you get too many
# "couldn't find" replies, lower if answers drift. 0 disables.
CHAT_MAX_DISTANCE=0.75
CHAT_HISTORY_TURNS=6
CHAT_CONTEXT_CHARS=10000

# ============================================================
# On the Ollama HOST (systemd override / environment), not in this file:
#   OLLAMA_MAX_LOADED_MODELS=3     # embed model + chat model + one more stay resident
#   OLLAMA_NUM_PARALLEL=2
#   OLLAMA_KEEP_ALIVE=30m
# Check with:  ollama ps   (PROCESSOR column shows 100% CPU vs GPU, UNTIL shows keep-alive)
# ============================================================
